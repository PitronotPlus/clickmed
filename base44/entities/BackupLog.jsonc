{
  "name": "BackupLog",
  "type": "object",
  "properties": {
    "backup_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9"
    },
    "generated_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d9\u05e6\u05e8 \u05d0\u05ea \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9"
    },
    "file_size_kb": {
      "type": "number",
      "description": "\u05d2\u05d5\u05d3\u05dc \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d1\u05e7\u05d9\u05dc\u05d5\u05d1\u05d9\u05d9\u05d8"
    },
    "file_count": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e7\u05d1\u05e6\u05d9\u05dd \u05e9\u05e0\u05db\u05dc\u05dc\u05d5 \u05d1\u05d2\u05d9\u05d1\u05d5\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da",
        "\u05d4\u05d5\u05e9\u05dc\u05dd",
        "\u05e0\u05db\u05e9\u05dc"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4"
    }
  },
  "required": [
    "backup_date",
    "generated_by",
    "status"
  ]
}