{
  "name": "Request",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (\u05dc\u05e0\u05d5\u05d7\u05d9\u05d5\u05ea \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "doctor_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05d8\u05e4\u05dc (\u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e8\u05d9\u05e7 \u05d0\u05dd \u05d4\u05d1\u05e7\u05e9\u05d4 \u05d1\u05d6\u05d9\u05e8\u05d4)"
    },
    "doctor_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05d8\u05e4\u05dc (\u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e8\u05d9\u05e7)"
    },
    "type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d1\u05e7\u05e9\u05d4 (\u05e9\u05dd \u05d4\u05d4\u05ea\u05de\u05d7\u05d5\u05ea)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "doctor_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05e8\u05d5\u05e4\u05d0 \u05e2\u05dc \u05d4\u05d1\u05e7\u05e9\u05d4, \u05e9\u05d2\u05dc\u05d5\u05d9\u05d5\u05ea \u05dc\u05de\u05d8\u05d5\u05e4\u05dc"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d1\u05e7\u05e9\u05d4 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4",
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd",
        "\u05de\u05d0\u05d5\u05e9\u05e8",
        "\u05d8\u05d5\u05e4\u05dc",
        "\u05d1\u05e7\u05e9\u05d4 \u05e0\u05d3\u05d7\u05ea\u05d4",
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d6\u05d9\u05de\u05d5\u05df \u05ea\u05d5\u05e8",
        "\u05d1\u05d5\u05d8\u05dc",
        "\u05de\u05d7\u05e4\u05e9 \u05e8\u05d5\u05e4\u05d0",
        "\u05de\u05d7\u05e4\u05e9 \u05e8\u05d5\u05e4\u05d0 - \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "time": {
      "type": "string",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d5\u05e8"
    },
    "day_name": {
      "type": "string",
      "description": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05d5\u05d0 \u05de\u05e0\u05d5\u05d9 \u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd"
    },
    "discount_applied": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05e0\u05d7\u05d4 \u05e9\u05d4\u05d5\u05d7\u05dc (\u05dc\u05de\u05e0\u05d5\u05d9\u05d9 \u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd)"
    },
    "original_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05de\u05e7\u05d5\u05e8\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e0\u05d7\u05d4"
    },
    "final_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05e1\u05d5\u05e4\u05d9 \u05d0\u05d7\u05e8\u05d9 \u05d4\u05e0\u05d7\u05d4"
    },
    "questionnaire_answers": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON object of question-answer pairs"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ]
      },
      "description": "List of uploaded documents"
    },
    "rejection_reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d3\u05d7\u05d9\u05d9\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e8\u05d5\u05e4\u05d0"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "type",
    "description",
    "status",
    "date",
    "time",
    "day_name"
  ]
}