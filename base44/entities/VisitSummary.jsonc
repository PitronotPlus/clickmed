{
  "name": "VisitSummary",
  "type": "object",
  "properties": {
    "doctor_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05d5\u05e4\u05d0"
    },
    "patient_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc"
    },
    "visit_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8"
    },
    "summary_content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e1\u05d9\u05db\u05d5\u05dd \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 HTML"
    },
    "template_used": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05e9\u05d9\u05de\u05e9\u05d4"
    },
    "diagnosis": {
      "type": "string",
      "description": "\u05d0\u05d1\u05d7\u05e0\u05d4"
    },
    "treatment": {
      "type": "string",
      "description": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05e0\u05d9\u05ea\u05df"
    },
    "followup_required": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05de\u05e2\u05e7\u05d1"
    },
    "followup_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05e2\u05e7\u05d1 \u05de\u05d5\u05de\u05dc\u05e5"
    }
  },
  "required": [
    "doctor_id",
    "patient_id",
    "visit_date",
    "summary_content"
  ]
}