{
  "name": "Referral",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e8\u05e4\u05d0\u05d4"
    },
    "patient_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d8\u05d5\u05e4\u05dc"
    },
    "patient_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (\u05de\u05d5\u05e1\u05ea\u05e8)"
    },
    "service": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "completed",
        "cancelled"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d4\u05e4\u05e0\u05d9\u05d4"
    },
    "commission": {
      "type": "number",
      "description": "\u05e2\u05de\u05dc\u05d4"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cancelled"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05e0\u05d9\u05d4"
    },
    "referral_link": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e0\u05d9\u05d4"
    }
  },
  "required": [
    "clinic_id",
    "patient_id",
    "service",
    "status",
    "commission",
    "date"
  ]
}