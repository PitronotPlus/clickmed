{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05e0\u05d5\u05d7\u05d9\u05d5\u05ea \u05d4\u05e6\u05d2\u05d4"
    },
    "doctor_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05d8\u05e4\u05dc"
    },
    "doctor": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05d5\u05e4\u05d0"
    },
    "specialty": {
      "type": "string",
      "description": "\u05ea\u05d7\u05d5\u05dd \u05d4\u05d4\u05ea\u05de\u05d7\u05d5\u05ea"
    },
    "clinic": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e8\u05e4\u05d0\u05d4"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d4\u05ea\u05d5\u05e8"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05d5\u05e8 \u05e9\u05dc \u05de\u05e0\u05d5\u05d9 \u05e4\u05e8\u05d9\u05d9\u05de\u05d9\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8",
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd",
        "\u05de\u05d0\u05d5\u05e9\u05e8",
        "\u05d8\u05d5\u05e4\u05dc",
        "\u05d1\u05d5\u05d8\u05dc"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05d5\u05e8"
    },
    "discount_applied": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05e0\u05d7\u05d4 \u05e9\u05d4\u05d5\u05d7\u05dc"
    },
    "original_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "final_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d0\u05d7\u05e8\u05d9 \u05d4\u05e0\u05d7\u05d4"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "payment_method": {
      "type": "string",
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05d5\u05e8"
    }
  },
  "required": [
    "user_id",
    "doctor_id",
    "doctor",
    "specialty",
    "date"
  ]
}