        "\u05d4\u05d5\u05e4\u05e1\u05e7",
        "\u05d4\u05d5\u05e9\u05dc\u05dd"
      ],
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "patient_id",
    "name",
    "dosage",
    "doctor",
    "start_date",
    "status"
  ]
