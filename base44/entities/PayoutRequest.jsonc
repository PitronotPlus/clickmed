{
  "name": "PayoutRequest",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e8\u05e4\u05d0\u05d4 (\u05de\u05ea\u05d5\u05da \u05d8\u05d1\u05dc\u05ea User)"
    },
    "clinic_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e8\u05e4\u05d0\u05d4"
    },
    "amount_requested": {
      "type": "number",
      "description": "\u05d4\u05e1\u05db\u05d5\u05dd \u05d4\u05de\u05d1\u05d5\u05e7\u05e9 \u05dc\u05de\u05e9\u05d9\u05db\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05df",
        "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc",
        "\u05d4\u05d5\u05e9\u05dc\u05dd",
        "\u05e0\u05d3\u05d7\u05d4"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05df",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05e7\u05e9\u05ea \u05d4\u05de\u05e9\u05d9\u05db\u05d4"
    },
    "rejection_reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d3\u05d7\u05d9\u05d9\u05d4 (\u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    },
    "processed_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "transaction_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05e1\u05e7\u05d4/\u05d0\u05e1\u05de\u05db\u05ea\u05d0"
    }
  },
  "required": [
    "clinic_id",
    "clinic_name",
    "amount_requested"
  ]
}