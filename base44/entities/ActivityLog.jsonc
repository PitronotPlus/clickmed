{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "action": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (\u05dc\u05de\u05e9\u05dc, '\u05e2\u05d3\u05db\u05d5\u05df \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e8\u05d5\u05e4\u05d0')"
    },
    "target_entity": {
      "type": "string",
      "description": "\u05d4\u05d9\u05e9\u05d5\u05ea \u05e2\u05dc\u05d9\u05d4 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (\u05dc\u05de\u05e9\u05dc, 'User')"
    },
    "target_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05e2\u05dc\u05d9\u05d4 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "details": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e2\u05dc \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (JSON string)"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "action"
  ]
}