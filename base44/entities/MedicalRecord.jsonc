{
  "name": "MedicalRecord",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc"
    },
    "blood_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d3\u05dd"
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05dc\u05e8\u05d2\u05d9\u05d5\u05ea"
    },
    "chronic_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d7\u05dc\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05d5\u05ea"
    },
    "emergency_contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        }
      },
      "description": "\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05dc\u05d7\u05d9\u05e8\u05d5\u05dd"
    },
    "insurance": {
      "type": "string",
      "description": "\u05e7\u05d5\u05e4\u05ea \u05d7\u05d5\u05dc\u05d9\u05dd"
    },
    "last_update": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "patient_id",
    "blood_type",
    "insurance"
  ]
}