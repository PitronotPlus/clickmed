{
  "name": "CreditBalance",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "sms_credits": {
      "type": "number",
      "default": 0,
      "description": "\u05d9\u05ea\u05e8\u05ea SMS"
    },
    "email_credits": {
      "type": "number",
      "default": 0,
      "description": "\u05d9\u05ea\u05e8\u05ea \u05d0\u05d9\u05de\u05d9\u05d9\u05dc\u05d9\u05dd"
    },
    "phone_minutes": {
      "type": "number",
      "default": 0,
      "description": "\u05d3\u05e7\u05d5\u05ea \u05e9\u05d9\u05d7\u05d4 \u05d6\u05de\u05d9\u05e0\u05d5\u05ea"
    },
    "phone_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05de\u05e1\u05e4\u05e8\u05d9 \u05d8\u05dc\u05e4\u05d5\u05df \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "user_id"
  ]
}