{
  "name": "QuestionnaireResponse",
  "type": "object",
  "properties": {
    "questionnaire_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d5\u05df"
    },
    "questionnaire_title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05d0\u05dc\u05d5\u05df"
    },
    "patient_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc"
    },
    "patient_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc"
    },
    "doctor_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05d5\u05e4\u05d0 \u05e9\u05e9\u05dc\u05d7"
    },
    "responses": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05df"
    },
    "signature": {
      "type": "string",
      "description": "\u05d7\u05ea\u05d9\u05de\u05d4 \u05d3\u05d9\u05d2\u05d9\u05d8\u05dc\u05d9\u05ea (base64)"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e9\u05dc\u05de\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05e9\u05dc\u05d5\u05d7",
        "\u05d4\u05d5\u05e9\u05dc\u05dd"
      ],
      "default": "\u05e9\u05dc\u05d5\u05d7",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e9\u05d0\u05dc\u05d5\u05df"
    }
  },
  "required": [
    "questionnaire_id",
    "patient_id",
    "responses"
  ]
}